# Aura 组件库 —— npm / pnpm 配置

# 跨包依赖统一保存为 workspace:*（pnpm 7 默认行为，此处显式声明）
save-workspace-protocol=true

# 组件库对 react / antd 的版本约束写在各包 peerDependencies 中，
# 由 peer 机制提示而非阻断安装，避免使用方被硬性卡住。
strict-peer-dependencies=false
auto-install-peers=true

# 发布范围：scoped 包（@scope/name）在 npm 上默认为 private（需要付费套餐），
# 必须显式声明 public。各包 package.json#publishConfig.access 已声明，这里是兜底。
access=public

# 认证说明 —— 本文件**不要**写 token（它会随仓库泄露）：
#   · 日常发布：由 .github/workflows/release.yml 走 OIDC（Trusted Publishing）免 token 认证。
#   · 首次发布（包在 npm 上尚不存在、无法绑定 Trusted Publisher 时）：
#     用用户级 ~/.npmrc 或临时 NPM_TOKEN 环境变量。token 必须是
#     Granular Access Token 且勾选 Bypass 2FA，否则 PUT 会被 npm 拒绝。
