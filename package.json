{
  "name": "aura-ui",
  "version": "0.0.1",
  "private": true,
  "description": "Aura UI - 基于 React 18 的企业级组件库",
  "scripts": {
    "dev": "dumi dev",
    "build": "dumi build",
    "build:lib": "pnpm -C packages/ui build",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "prepare": "dumi setup",
    "clean": "rm -rf packages/*/lib packages/*/esm packages/*/dist .dumi",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "react",
    "component-library",
    "ui",
    "monorepo"
  ],
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dumi": "^2.4.26",
    "jsdom": "^29.1.1",
    "react": "^18",
    "react-dom": "^18",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
