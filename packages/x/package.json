      "import": "./esm/index.js",
      "default": "./esm/index.js"
    },
    "./style.css": "./esm/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "father build && node scripts/build-styles.mjs",
    "dev": "father dev"
  },
  "peerDependencies": {
    "antd": ">=6.0.0",
    "mermaid": ">=10.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "dependencies": {
    "@aura-react-comp/shared": "workspace:*",
    "prism-react-renderer": "^2.4.1",
    "react-markdown": "^10.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "less": "^4.9.1",
    "mermaid": "^12.0.0"
  }
