{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@aura-react-comp/design": ["./packages/design/src/index.ts"],
      "@aura-react-comp/icons": ["./packages/icons/src/index.ts"],
      "@aura-react-comp/shared": ["./packages/shared/src/index.ts"],
      "@aura-react-comp/request": ["./packages/request/src/index.ts"],
      "@aura-react-comp/business": ["./packages/business/src/index.ts"],
      "@aura-react-comp/x": ["./packages/x/src/index.ts"],
      "@aura-react-comp/motion": ["./packages/motion/src/index.ts"],
      "@aura-react-comp/charts": ["./packages/charts/src/index.ts"],
      "@aura-react-comp/charts-3d": ["./packages/charts-3d/src/index.ts"],
      "@aura-react-comp/editor": ["./packages/editor/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "tests", ".dumi"],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "dist",
    "esm",
    "lib",
    ".dumi/tmp",
    ".dumi/tmp-production"
  ]
}
